PORT=8000
APP_BASE_URL=http://127.0.0.1:8000

# Optional. If this is not set, the app uses the built-in local analyzer so the
# MVP can be tested without network access. Set this to use OpenAI-compatible AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional. Feishu bot webhook for risk/exception notifications.
FEISHU_WEBHOOK_URL=

# Optional. Gmail OAuth for creating drafts only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Set to 1 to verify the ai_failed flow. Original replies are still saved.
AI_FORCE_FAIL=0
